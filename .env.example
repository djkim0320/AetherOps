# AetherOps does not load secrets from repository files in production.
# Tests that explicitly exercise the embeddings API may use this process variable.
OPENAI_API_KEY=

# Development-only signed runtime feed overrides. Production builds inject the
# same public values with Go linker flags; configure all three or none.
AETHEROPS_RUNTIME_FEED_URL=
AETHEROPS_RUNTIME_KEY_ID=
AETHEROPS_RUNTIME_PUBLIC_KEY_BASE64=
